#!/bin/sh
# A "noisy" version for debugging
set -e

case "$1" in
    configure)
        echo "    /---\/---\/---\    "
        echo "    |   ||   ||   |    "
        echo "    \---/\---/\---/    "
        echo "   Amulet Hotkey Ltd   "    
        echo "Enabling CoreStationHXAgent Service..."

        if [ -x "/usr/bin/deb-systemd-helper" ]; then
            deb-systemd-helper enable CoreStationHXAgent.service || true
        fi

        echo "Starting CoreStationHXAgent Service..."

        if [ -x "/bin/systemctl" ] || [ -x "/usr/bin/systemctl" ]; then
            systemctl daemon-reload >/dev/null || true
            systemctl restart CoreStationHXAgent.service >/dev/null || true
        fi
        
        echo "--- postinst script finished ---"
    ;;
esac

#DEBHELPER#

exit 0