// trayapp.rc
#include <windows.h>
#include "resource.h"      // For IDI_TRAYICON
#include "version_info.h"

// Icon Resource
IDI_TRAYICON   ICON    "build\\ahk_white.ico" // IMPORTANT: Replace with the actual path to your icon file

// Version Information Block
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     VER_FILE_VERSION
 PRODUCTVERSION  VER_PRODUCT_VERSION
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Language: U.S. English, Character Set: Unicode
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Amulet Hotkey Ltd"
            VALUE "FileDescription",  "CoreStation HX Agent Tray Application"
            VALUE "FileVersion",      VER_FILE_VERSION_STR
            VALUE "InternalName",     "CoreStation_HX_Agent_Tray.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2025 Amulet Hotkey Ltd. All rights reserved."
            VALUE "OriginalFilename", "CoreStation_HX_Agent_Tray.exe"
            VALUE "ProductName",      "CoreStation HX Agent Tray Application"
            VALUE "ProductVersion",   VER_PRODUCT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // The following line indicates the language and character set.
        VALUE "Translation", 0x409, 1200
    END
END