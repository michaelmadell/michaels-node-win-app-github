      "Intel(R) Core(TM) Ultra 7 165H",
      "Intel(R) Core(TM) Ultra 7 165U",
      "Intel(R) Core(TM) Ultra 9 285H"
    ],
    "Hx2000PortWindows": "COM3",
    "Hx3000PortWindows": "COM1",
    "Hx2000PortLinux": "/dev/ttyS2",
    "Hx3000PortLinux": "/dev/ttyS0"
  }
}
