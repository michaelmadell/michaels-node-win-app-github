{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "PortName": "",
    "BaudRate": 115200,
    "ReconnectDelayMilliseconds": 5000,
