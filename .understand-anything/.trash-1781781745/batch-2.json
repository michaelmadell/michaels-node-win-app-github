    {
      "id": "file:src/modules/serial/SerialManager.cpp",
      "type": "file",
      "name": "SerialManager.cpp",
      "filePath": "src/modules/serial/SerialManager.cpp",
      "summary": "Cross-platform implementation of serial port communication (open/close/read/write/reconnect) supporting both Windows (CreateFileA/HANDLE) and POSIX (termios) backends, with message framing and retry-delay-based reconnection logic.",
      "tags": ["serial-communication", "cross-platform", "device-io"],
      "complexity": "complex",
      "languageNotes": "Uses #ifdef _WIN32 branching throughout to swap between WinAPI HANDLE-based I/O and POSIX file-descriptor/termios-based I/O within the same class methods."
    },
