      "name": "sendLineToBmc",
      "filePath": "src/main.cpp",
      "lineRange": [56, 64],
      "summary": "Writes a line of text to the BMC (CoreStation HX CMC) over the active serial manager, logging the outgoing message.",
      "tags": ["utility", "serial-communication"],
      "complexity": "simple"
    },
    {
