  "nodes": [
    {
      "id": "file:src/platform/LinuxPlatform.cpp",
      "type": "file",
      "name": "LinuxPlatform.cpp",
      "filePath": "src/platform/LinuxPlatform.cpp",
      "summary": "Linux-specific implementation of the Platform interface, providing serial port I/O, network interface enumeration, system metrics (CPU/RAM/disk/GPU), D-Bus session monitoring, and syslog-based logging for the host agent.",
      "tags": ["platform-implementation", "linux", "system-metrics", "serial-communication", "service"],
      "complexity": "complex",
      "languageNotes": "Uses libdbus for session-state signal monitoring on a dedicated thread, /proc parsing for CPU/RAM stats, and popen-based shell command execution for GPU and Windows-Update-equivalent checks."
    },
    {
      "id": "file:src/platform/Windows_Addon.h",
      "type": "file",
      "name": "Windows_Addon.h",
      "filePath": "src/platform/Windows_Addon.h",
      "summary": "Small header of Windows-specific RAII helpers: custom deleters for HANDLE and PDH_HQUERY smart pointers, and a COM library initializer/uninitializer wrapper.",
      "tags": ["utility", "raii", "windows", "type-definition", "resource-management"],
      "complexity": "simple",
      "languageNotes": "Defines std::unique_ptr type aliases (UniqueHandle, UniquePdhQuery) with custom deleter functors to ensure deterministic cleanup of Win32 resources."
    },
