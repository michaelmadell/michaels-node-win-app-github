    {
      "id": "file:src/platform/WindowsPlatform.cpp",
      "type": "file",
      "name": "WindowsPlatform.cpp",
      "filePath": "src/platform/WindowsPlatform.cpp",
      "summary": "Windows-specific implementation of the Platform interface and Windows Service entry point: handles SCM service lifecycle, serial port I/O, network/adapter enumeration via IP Helper API, WMI-based GPU driver queries, PDH performance counters, registry-based OS version detection, and high-RAM process discovery.",
      "tags": ["platform-implementation", "windows", "windows-service", "system-metrics", "com"],
      "complexity": "complex",
      "languageNotes": "Combines Win32 Service Control Manager APIs (ServiceMain, ServiceCtrlHandler), WMI/COM (IWbemServices) for GPU driver info, PDH performance counters, and metric caching via MetricCache<T> to avoid redundant expensive system calls."
    },
