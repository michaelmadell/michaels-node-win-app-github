    {
      "id": "file:src/core/Platform.h",
      "type": "file",
      "name": "Platform.h",
      "filePath": "src/core/Platform.h",
      "summary": "Defines the abstract Platform interface that exposes all OS-specific operations (networking, serial I/O, system metrics, GPU info, dialogs) required by the agent, allowing platform-specific implementations to be swapped behind a common API.",
      "tags": ["interface", "abstraction-layer", "platform-specific", "entry-point"],
      "complexity": "moderate",
      "languageNotes": "Pure virtual interface (abstract base class) pattern used to decouple platform-specific (Windows/Linux) implementations from the rest of the agent."
    },
    {
      "id": "class:src/core/Platform.h:Platform",
      "type": "class",
      "name": "Platform",
      "filePath": "src/core/Platform.h",
      "lineRange": [14, 52],
      "summary": "Abstract interface declaring all platform-dependent operations the agent needs: network/session/OS info, serial port control, logging, performance and GPU metrics, and UI dialogs.",
      "tags": ["interface", "abstraction-layer", "platform-specific"],
      "complexity": "moderate"
    },
    {
      "id": "file:src/core/SystemState.h",
