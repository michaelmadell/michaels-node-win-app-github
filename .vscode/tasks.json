{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe debug build (active file)",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/MT",       // <-- Statically link runtime dll
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }, 

        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe Release build",
            "command": "cl.exe",
            "args": [
                "/O2",                   // Optimize for speed
                "/DNDEBUG",              // Disable debug asserts
                "/EHsc",
                "/MT",                   // Static runtime
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}_release.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Release build with static runtime"
        },

        {
            "label": "Run clang-tidy (Current File)",
            "type": "shell",
            "command": "C:\\LLVM\\bin\\clang-tidy.exe",
            "args": [
              "${file}",
              "--",
              "-std=c++17", 
              "-Iinclude"
            ],
            "problemMatcher": [],
            "group": {
              "kind": "build",
              "isDefault": false
            },
        }
    ],
    "problemMatcher": [
        {
            "owner": "cpp",
            "fileLocation": ["relative", "${workspaceFolder}"],
            "pattern": {
            "regexp": "^(.*):([0-9]+):([0-9]+): (warning|error): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
            }
        }
    ],
    "version": "2.0.0"
}