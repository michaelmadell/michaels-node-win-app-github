{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }, 
        {
            "label": "Run clang-tidy (Current File)",
            "type": "shell",
            "command": "clang-tidy",
            "args": [
              "${file}",
              "--",
              "-std=c++17", 
              "-Iinclude"
            ],
            "problemMatcher": [],
            "group": {
              "kind": "build",
              "isDefault": false
            },
        }
    ],
    "problemMatcher": [
        {
            "owner": "cpp",
            "fileLocation": ["relative", "${workspaceFolder}"],
            "pattern": {
            "regexp": "^(.*):([0-9]+):([0-9]+): (warning|error): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
            }
        }
    ],
    "version": "2.0.0"
}